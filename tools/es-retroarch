#!/usr/bin/env bash
# Lanza RetroArch desde EmulationStation (lo usan los <command> de es_systems.cfg):
#   es-retroarch -L /usr/lib/libretro/<núcleo>_libretro.so %ROM%
#
# - Añade /etc/emulationstation/retroarch-forzado.cfg (--appendconfig): ajustes
#   que deben cumplirse aunque el retroarch.cfg del volumen sea antiguo o se
#   haya cambiado desde el menú (vsync desactivado: con GNOME en Wayland
#   congela los juegos en el primer fotograma).
# - Pone la ventana en pantalla completa real. GNOME trata la pantalla completa
#   de RetroArch 1.7.3 como una ventana maximizada (con la barra superior), así
#   que se pide desde fuera con wmctrl en cuanto la ventana aparece.
set -uo pipefail

retroarch -f --appendconfig /etc/emulationstation/retroarch-forzado.cfg "$@" &
pid=$!
trap 'kill -TERM "${pid}" 2>/dev/null' TERM INT

# wmctrl solo ve las ventanas ya gestionadas por el escritorio (mapeadas);
# se reintenta hasta 10 s mientras RetroArch siga vivo.
for _ in $(seq 1 100); do
    kill -0 "${pid}" 2>/dev/null || break
    wmctrl -r RetroArch -b add,fullscreen 2>/dev/null && break
    sleep 0.1
done

wait "${pid}"
